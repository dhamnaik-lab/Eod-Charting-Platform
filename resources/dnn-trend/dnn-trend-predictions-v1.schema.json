{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eod-chart.local/schemas/dnn-trend-predictions-v1.schema.json",
  "title": "EOD Charting Platform precomputed DNN trend predictions V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model", "predictions"],
  "properties": {
    "schemaVersion": {
      "const": "dnn-trend-predictions-v1"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "modelVersion",
        "featureVersion",
        "generatedAt",
        "productionReady"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "featureVersion": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "productionReady": { "type": "boolean" }
      }
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "exchange",
          "timeframe",
          "asOfDate",
          "dataRevision",
          "horizonBars",
          "bullishProbability",
          "sidewaysProbability",
          "bearishProbability"
        ],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "exchange": { "type": "string", "pattern": "^(?:[Nn][Ss][Ee]|[Bb][Ss][Ee])$" },
          "timeframe": { "const": "1D" },
          "asOfDate": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "dataRevision": { "type": "string", "minLength": 1 },
          "horizonBars": { "enum": [5, 10, 20] },
          "bullishProbability": { "type": "number", "minimum": 0, "maximum": 1 },
          "sidewaysProbability": { "type": "number", "minimum": 0, "maximum": 1 },
          "bearishProbability": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
