{
  "name": "eod-chart",
  "version": "0.1.0",
  "description": "EOD charting platform for Indian markets",
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:renderer": "vite",
    "tauri:dev": "cd src-tauri-shell && tauri dev --config tauri.conf.json",
    "pretauri:build": "node .\\scripts\\generate-build-metadata.cjs",
    "tauri:build": "cd src-tauri-shell && tauri build --config tauri.conf.json",
    "pretauri:bundle:nsis": "node .\\scripts\\generate-build-metadata.cjs",
    "tauri:bundle:nsis": "cd src-tauri-shell && tauri bundle --config tauri.conf.json --bundles nsis",
    "tauri:portable:win": "npm run tauri:build && powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\prepare-tauri-portable.ps1",
    "tauri:check": "cargo check --manifest-path src-tauri-shell/Cargo.toml",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build": "npm run typecheck:renderer && npm run tauri:check && npm run build:renderer",
    "test": "vitest run --exclude tmp/**"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "technicalindicators": "^3.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
